---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

  <section id="about" class="py-32 md:py-40 relative">
    <div class="max-w-4xl mx-auto px-6 md:px-10">
      <div class="reveal mb-12">
        <span class="section-label">{t('about.label')}</span>
        <h2 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl mt-6 leading-tight">
          <span>{t('about.title1')}</span><br>
          <span class="text-gradient">{t('about.title2')}</span>
        </h2>
      </div>
      <div class="reveal space-y-5 text-ink-200 text-lg md:text-xl leading-relaxed" style="transition-delay: 120ms">
        <p set:html={t('about.p1')}></p>
        <p set:html={t('about.p2')}></p>
        <p set:html={t('about.p3')}></p>
        <p set:html={t('about.p4')}></p>
        <p class="text-accent-cyan font-mono text-base">{t('about.available')}</p>
      </div>
    </div>
  </section>
